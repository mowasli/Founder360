# Local defaults. Copy to .env.local; never commit secrets.
APP_ENV=development
HOST=0.0.0.0
PORT=8000
FOUNDER360_DATA_DIR=.data
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional PostgreSQL. SQLite WAL works without this.
# DATABASE_URL=postgresql://founder360:CHANGE_ME@localhost:5432/founder360
# Production requires a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DATA_ENCRYPTION_KEY=

# External services are deliberately disabled by default.
AI_PROVIDER=offline
AI_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
AI_MAX_OUTPUT_TOKENS=1800
# Set from current provider pricing. Reservations are not a guarantee of the provider bill.
AI_MONTHLY_BUDGET_USD=0
AI_REQUEST_RESERVATION_USD=0
